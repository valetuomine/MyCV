# Set only for production builds. Leave empty locally to use the Vite proxy.
VITE_API_BASE_URL=

# Public Entra app registration values. Never put a client secret here.
VITE_ENTRA_CLIENT_ID=
VITE_ENTRA_TENANT_ID=
VITE_ENTRA_API_SCOPE=

# Public Google OAuth client ID. Never put the client secret here.
VITE_GOOGLE_CLIENT_ID=

# Set to "local" only for the Playwright tests (e2e), in .env.development.local.
# Only the dev server honours it: `vite build` ignores it. It keeps the
# Microsoft and Google sessions in local storage, which saved test sessions can
# hold. Leave empty everywhere else, so a session never outlives its tab.
VITE_AUTH_STORAGE=
