<Project>

  <PropertyGroup>
    <!-- A new Sonar finding or compiler warning fails the Release build. NuGet audit warnings stay warnings, because a new advisory should not break an unrelated change. -->
    <TreatWarningsAsErrors Condition="'$(Configuration)' == 'Release'">true</TreatWarningsAsErrors>
    <WarningsNotAsErrors>$(WarningsNotAsErrors);NU1901;NU1902;NU1903;NU1904</WarningsNotAsErrors>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="SonarAnalyzer.CSharp" Version="10.36.0.15337" PrivateAssets="all" />
  </ItemGroup>

</Project>
