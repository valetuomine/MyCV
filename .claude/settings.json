{
  "permissions": {
    "deny": [
      "Read(./src/Frontend/package-lock.json)",
      "Read(./src/Frontend/src/generated/**)",
      "Read(./src/Frontend/dist/**)"
    ]
  },
  "statusLine": {
    "type": "command",
    "command": "node \"${CLAUDE_PROJECT_DIR:-.}/.claude/hooks/usage-statusline.mjs\""
  },
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/.claude/hooks/usage-budget.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "NODE_USE_ENV_PROXY=1 node \"$CLAUDE_PROJECT_DIR/.claude/hooks/model-hint.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
